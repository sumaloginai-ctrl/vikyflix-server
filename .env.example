# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed, printed, or pasted into logs.

# API port (Render injects its own PORT).
PORT=5000

# Secret for the control endpoints (POST /api/moviebox/refresh and friends).
# Must be a long random string in production; the code fallback is not a secret.
ADMIN_KEY=change-me-long-random-string

# Local media roots, comma separated. The personal library feature is
# discontinued; leave empty unless you intentionally re-enable it.
MEDIA_DIRS=

# Where posters, catalog snapshots and transcode scratch live.
# Empty = <server>/cache
CACHE_DIR=

# Maximum size of the transcode/poster cache, in GB.
CACHE_MAX_GB=2

# Set to "off" to force software ffmpeg (disables hardware encoding).
TRANSCODE_HW=
